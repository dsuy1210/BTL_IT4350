+# ---- Bands
+s.rect(20, 70, W - 40, 420, fill="#FFFFE6", stroke=BUS_S, sw=1.5, rx=8, dash="8 5")
+s.text(36, 86, "BUSINESS LAYER", size=13, weight="700", fill="#7a7400", anchor="start")
